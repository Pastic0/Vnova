@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Vnova</title>
    <link rel="icon" data-site-logo />
    <link rel="stylesheet" href="/css/login_signup_style.css?v=2026-10-18-google-login-v4" />
    <script src="/script/accounts.js?v=2026-10-18-google-login-v4"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
  <link rel="stylesheet" href="/css/vnova_font.css?v=2026-10-18-chatbot-rename-v1" />
    <script defer src="/script/site_branding.js?v=2026-08-05-uploaded-logo-only-v6"></script>
</head>
  <body>
    @await Html.PartialAsync("~/Views/Shared/_VnovaFloatingTools.cshtml")
    <h1 class="title">
      <a class="brand-home-link" href="/landing" aria-label="Về Landing Page Vnova">
        <img
          data-site-logo
          alt="Vnova Logo"
          style="height: 50px; margin-right: 10px"
        />
        <span>Vnova</span>
      </a>
    </h1>

    <div class="container">
      <div class="login-container">
        <h2 class="login-title">Đăng nhập</h2>
        <form class="login-form" onsubmit="handleLogin(event)">
          <input type="text" id="email" placeholder="Email" required />
          <div class="password-field">
            <input
              type="password"
              id="password"
              placeholder="Mật khẩu"
              autocomplete="current-password"
              required
            />
            <button
              type="button"
              class="password-toggle"
              id="togglePassword"
              aria-label="Hiện mật khẩu"
              aria-controls="password"
              aria-pressed="false"
              title="Hiện mật khẩu"
            >
              <!-- Mắt nhắm: mật khẩu đang ẩn (mặc định) -->
              <svg class="icon-eye-closed" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                <line x1="1" y1="1" x2="23" y2="23" />
              </svg>
              <!-- Mắt mở: mật khẩu đang hiện -->
              <svg class="icon-eye-open" viewBox="0 0 24 24" aria-hidden="true" hidden>
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </button>
          </div>
          <button type="submit" class="login-btn">Đăng nhập</button>
        </form>
        <div class="auth-divider" aria-hidden="true"><span>hoặc</span></div>
        <div id="googleSignInBtn" class="google-signin" data-client-id="@(!string.IsNullOrWhiteSpace(Config["GOOGLE_CLIENT_ID"]) ? Config["GOOGLE_CLIENT_ID"] : (!string.IsNullOrWhiteSpace(Config["Google:ClientId"]) ? Config["Google:ClientId"] : "972719886335-itodg0rmluk22s237hpvkj5rabufdp0t.apps.googleusercontent.com"))"></div>
        <p class="signup-text">
          Chưa có tài khoản?
          <a href="/signup" class="signup-link">Đăng ký</a>
        </p>
        <p class="change-password">
          Quên mật khẩu?
          <a href="/forgot-password" class="signup-link">Đặt lại mật khẩu</a>
        </p>
      </div>

    </div>
<script>
  (function () {
    var input = document.getElementById("password");
    var button = document.getElementById("togglePassword");
    if (!input || !button) return;
    var closedIcon = button.querySelector(".icon-eye-closed");
    var openIcon = button.querySelector(".icon-eye-open");

    function setVisible(visible) {
      input.type = visible ? "text" : "password";
      button.setAttribute("aria-pressed", visible ? "true" : "false");
      var label = visible ? "Ẩn mật khẩu" : "Hiện mật khẩu";
      button.setAttribute("aria-label", label);
      button.title = label;
      if (closedIcon) closedIcon.hidden = visible;
      if (openIcon) openIcon.hidden = !visible;
    }

    // Giữ con trỏ trong ô nhập khi bấm vào biểu tượng.
    button.addEventListener("mousedown", function (event) { event.preventDefault(); });
    button.addEventListener("click", function () {
      var start = input.selectionStart, end = input.selectionEnd;
      setVisible(input.type === "password");
      input.focus();
      try { input.setSelectionRange(start, end); } catch (_) {}
    });

    // Mặc định luôn ẩn mật khẩu, kể cả khi quay lại trang từ bộ nhớ đệm.
    setVisible(false);
    window.addEventListener("pageshow", function () { setVisible(false); });
  })();
</script>
<script src="/script/theme_toggle.js?v=2026-07-27-notification-cleanup-v3"></script>
</body>
</html>

